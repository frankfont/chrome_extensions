{
  "manifest_version": 3,
  "name": "Medium Reader Stats Info",
  "version": "1.0.0",
  "description": "Captures and compares Medium story stats snapshots.",
  "permissions": ["storage"],
  "host_permissions": ["https://medium.com/me/stats*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Medium Reader Stats Info",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://medium.com/me/stats*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
